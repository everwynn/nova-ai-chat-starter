<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.everwynn</groupId>
        <artifactId>nova-ai-chat-parent</artifactId>
        <version>0.1.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>nova-ai-chat-demo</artifactId>
    <packaging>jar</packaging>
    <name>Nova AI Chat Demo</name>
    <description>最小可运行示例：Mock 模式演示流式对话、停止与刷新回显</description>

    <properties>
        <!-- 示例不发布，不生成 sources/javadoc，也不需要签名 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.everwynn</groupId>
            <artifactId>nova-ai-chat-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
